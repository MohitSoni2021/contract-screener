# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
*.spec

# ─── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env.local
.env.*.local

# ─── Secrets – never bake credentials into the image ──────────────────────────
.env

# ─── Tests & dev tooling ───────────────────────────────────────────────────────
tests/
.pytest_cache/
pytest.ini
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ─── IDE / OS noise ───────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes
.DS_Store
Thumbs.db
*.swp
*.swo

# ─── Docs & misc ──────────────────────────────────────────────────────────────
README.md
docs/
*.md
data/
*.pdf
*.docx

# ─── Docker files themselves (avoid self-referential copies) ──────────────────
Dockerfile
.dockerignore
docker-compose*.yml
