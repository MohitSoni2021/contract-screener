# Copy to .env and fill in secrets locally. Never commit .env.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DATABASE=elcara
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5173,https://contract-screener.netlify.app
# Ingestion guardrails (defaults: 600 PDF pages, 15 MiB upload, 3 max docs per user, 3 million extracted characters)
MAX_PDF_PAGES=600
MAX_UPLOAD_BYTES=15728640
MAX_DOCUMENTS_PER_USER=3
MAX_EXTRACTED_CHARACTERS=3000000
MAX_EXTRACTED_TEXT_BYTES=12582912
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
QDRANT_CLUSTER_ENDPOINT=https://<cluster-id>.<region>.aws.cloud.qdrant.io
# For local Qdrant (fallback when QDRANT_CLUSTER_ENDPOINT is not set):
# QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=30
QDRANT_COLLECTION=document_chunks
RESEARCH_MAX_ROUNDS=8
RESEARCH_MAX_TOKENS=3200
# Supabase Storage (for persistent file storage across Render container restarts)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=documents
